{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI-BOM Inspector Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generated_at",
    "total_risk",
    "stack_risk_score",
    "risk_breakdown",
    "risk_settings",
    "dependencies",
    "models"
  ],
  "properties": {
    "generated_at": { "type": "string", "format": "date-time" },
    "ai_summary": { "type": ["string", "null"] },
    "total_risk": { "type": "integer", "minimum": 0 },
    "stack_risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "risk_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unpinned_deps": { "type": "integer", "minimum": 0 },
        "unverified_sources": { "type": "integer", "minimum": 0 },
        "unknown_licenses": { "type": "integer", "minimum": 0 },
        "stale_models": { "type": "integer", "minimum": 0 },
        "cves": { "type": "integer", "minimum": 0 },
        "model_lineage_missing": { "type": "integer", "minimum": 0 },
        "training_data_missing": { "type": "integer", "minimum": 0 },
        "license_ambiguity": { "type": "integer", "minimum": 0 },
        "model_risk_profiles": { "type": "integer", "minimum": 0 }
      }
    },
    "risk_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_score": { "type": "integer" },
        "severity_penalties": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "governance_penalty": { "type": "integer" },
        "cve_penalty": { "type": "integer" },
        "missing_intel_penalty": { "type": "integer" },
        "scoring_model": { "type": "string" },
        "scoring_model_version": { "type": "string" },
        "category_weights": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "weight_scale": { "type": "number" },
        "org_weights": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        },
        "temporal_multipliers": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "asset_criticality_multipliers": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "data_sensitivity_multipliers": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "environment_multipliers": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "provenance": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "approvals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "integrity_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "message", "severity"],
        "properties": {
          "kind": { "type": "string" },
          "path": { "type": "string" },
          "message": { "type": "string" },
          "severity": { "type": "string" },
          "code": { "type": ["string", "null"] }
        }
      }
    },
    "runtime_trace": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["trace_mode", "captured_at", "command"],
      "properties": {
        "trace_mode": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" },
        "command": { "type": "array", "items": { "type": "string" } },
        "imported_modules": { "type": "array", "items": { "type": "string" } },
        "observed_models": { "type": "array", "items": { "type": "string" } },
        "observed_dependencies": { "type": "array", "items": { "type": "string" } },
        "observed_env": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "completeness": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["static_coverage_pct", "runtime_coverage_pct", "static_visibility", "runtime_visibility"],
      "properties": {
        "static_coverage_pct": { "type": "number" },
        "runtime_coverage_pct": { "type": "number" },
        "static_visibility": { "type": "boolean" },
        "runtime_visibility": { "type": "boolean" },
        "unobservable_areas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "executive_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["governance_risk", "regulatory_exposure", "supply_chain_blast_radius"],
      "properties": {
        "governance_risk": { "type": "string" },
        "regulatory_exposure": { "type": "string" },
        "supply_chain_blast_radius": { "type": "string" },
        "rationale": { "type": "array", "items": { "type": "string" } }
      }
    },
    "framework_mapping": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["version", "source"],
      "properties": {
        "version": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "sbom_correlations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "model_metadata_summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "models_total": { "type": "integer", "minimum": 0 },
        "lineage_missing": { "type": "integer", "minimum": 0 },
        "training_data_missing": { "type": "integer", "minimum": 0 },
        "license_ambiguity": { "type": "integer", "minimum": 0 },
        "risk_profiles_flagged": { "type": "integer", "minimum": 0 }
      }
    },
    "policy_metadata": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "intel_versions": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "score_explanation": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "org_context": {
      "type": ["object", "null"],
      "additionalProperties": true
    },
    "threat_summary": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["version", "findings", "threat_counts"],
      "properties": {
        "version": { "type": "string" },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["subject", "subject_type", "issue_code", "severity", "threats", "stride", "mitre_atlas"],
            "properties": {
              "subject": { "type": "string" },
              "subject_type": { "type": "string" },
              "issue_code": { "type": "string" },
              "severity": { "type": "string" },
              "threats": { "type": "array", "items": { "type": "string" } },
              "stride": { "type": "array", "items": { "type": "string" } },
              "mitre_atlas": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "threat_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "source", "license", "license_category", "issues", "issue_details", "risk", "trust_signals", "trust_score"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "source": { "type": "string" },
          "license": { "type": "string" },
          "license_category": { "type": "string" },
          "issues": {
            "type": "array",
            "items": { "type": "string" }
          },
          "issue_details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message", "severity"],
              "properties": {
                "message": { "type": "string" },
                "severity": { "type": "string" },
                "code": { "type": ["string", "null"] },
                "metadata": {
                  "type": "object",
                  "additionalProperties": true
                },
                "frameworks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["framework", "control"],
                    "properties": {
                      "framework": { "type": "string" },
                      "control": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "risk": { "type": "integer" },
          "trust_signals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message", "severity"],
              "properties": {
                "message": { "type": "string" },
                "severity": { "type": "string" },
                "code": { "type": ["string", "null"] }
              }
            }
          },
          "trust_score": { "type": "integer" }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "license", "license_category", "last_updated", "issues", "issue_details", "risk", "trust_signals", "trust_score"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "license": { "type": "string" },
          "license_category": { "type": "string" },
          "last_updated": { "type": "string" },
          "base_models": {
            "type": "array",
            "items": { "type": "string" }
          },
          "fine_tuned_from": {
            "type": "array",
            "items": { "type": "string" }
          },
          "training_sources": {
            "type": "array",
            "items": { "type": "string" }
          },
          "hashes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "issues": {
            "type": "array",
            "items": { "type": "string" }
          },
          "issue_details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message", "severity"],
              "properties": {
                "message": { "type": "string" },
                "severity": { "type": "string" },
                "code": { "type": ["string", "null"] },
                "metadata": {
                  "type": "object",
                  "additionalProperties": true
                },
                "frameworks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["framework", "control"],
                    "properties": {
                      "framework": { "type": "string" },
                      "control": { "type": "string" }
                    }
                  }
                }
              }
            }
          },
          "risk": { "type": "integer" },
          "trust_signals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["message", "severity"],
              "properties": {
                "message": { "type": "string" },
                "severity": { "type": "string" },
                "code": { "type": ["string", "null"] }
              }
            }
          },
          "trust_score": { "type": "integer" }
        }
      }
    },
    "report_id": { "type": "string" },
    "rendered_at": { "type": "string", "format": "date-time" }
  }
}
